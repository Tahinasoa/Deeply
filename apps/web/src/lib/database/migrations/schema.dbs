			<script name="SQL_Editor" id="4f036bf4-b519-4a7f-9028-d9aed13f6ef3" language="SQL" >
				<string><![CDATA[-- =========================================================
-- SEED DATA
-- =========================================================

-- ---------------------------------------------------------
-- EDUCATIONAL SYSTEMS
-- ---------------------------------------------------------
INSERT INTO "public".educational_systems (id, name) VALUES
('es_en', 'English System'),
('es_fr', 'Systeme Francais'),
('es_mg', 'Systeme Malagasy');

-- ---------------------------------------------------------
-- GRADES
-- EN system uses US-style grade names.
-- FR and MG systems SHARE the same grade rows (francophone).
-- ---------------------------------------------------------
INSERT INTO "public".grades (id, name) VALUES
-- EN grades
('gr_6th',  '6th Grade'),
('gr_7th',  '7th Grade'),
('gr_8th',  '8th Grade'),
('gr_9th',  '9th Grade'),
('gr_10th', '10th Grade'),
('gr_11th', '11th Grade'),
('gr_12th', '12th Grade'),
-- FR/MG shared grades
('gr_6e',    '6eme'),
('gr_5e',    '5eme'),
('gr_4e',    '4eme'),
('gr_3e',    '3eme'),
('gr_2nd',   'Seconde'),
('gr_1ere',  'Premiere'),
('gr_term',  'Terminale');

-- ---------------------------------------------------------
-- SYSTEMS_GRADES (junction: which grades exist in which system)
-- Note: FR and MG both reference the SAME grade ids (gr_6e, gr_3e, ...)
-- ---------------------------------------------------------
INSERT INTO "public".systems_grades (id, system_id, grade_id) VALUES
-- EN
('sg_en_6th',  'es_en', 'gr_6th'),
('sg_en_7th',  'es_en', 'gr_7th'),
('sg_en_8th',  'es_en', 'gr_8th'),
('sg_en_9th',  'es_en', 'gr_9th'),
('sg_en_10th', 'es_en', 'gr_10th'),
('sg_en_11th', 'es_en', 'gr_11th'),
('sg_en_12th', 'es_en', 'gr_12th'),
-- FR
('sg_fr_6e',   'es_fr', 'gr_6e'),
('sg_fr_5e',   'es_fr', 'gr_5e'),
('sg_fr_4e',   'es_fr', 'gr_4e'),
('sg_fr_3e',   'es_fr', 'gr_3e'),
('sg_fr_2nd',  'es_fr', 'gr_2nd'),
('sg_fr_1ere', 'es_fr', 'gr_1ere'),
('sg_fr_term', 'es_fr', 'gr_term'),
-- MG (shares the same grade rows as FR)
('sg_mg_6e',   'es_mg', 'gr_6e'),
('sg_mg_5e',   'es_mg', 'gr_5e'),
('sg_mg_4e',   'es_mg', 'gr_4e'),
('sg_mg_3e',   'es_mg', 'gr_3e'),
('sg_mg_2nd',  'es_mg', 'gr_2nd'),
('sg_mg_1ere', 'es_mg', 'gr_1ere'),
('sg_mg_term', 'es_mg', 'gr_term');

-- ---------------------------------------------------------
-- SUBJECTS
-- Math / Sciences / Chinese are shared across ALL systems.
-- Francais / Histoire-Geo / EPS are shared between FR and MG only.
-- Espagnol -> FR only. Malagasy -> MG only. English -> EN only.
-- ---------------------------------------------------------
INSERT INTO "public".subjects (id, name, url_name, icon_path) VALUES
('sub_math',     'Mathematics',      'mathematics',      '/icons/math.svg'),
('sub_science',  'Science',          'science',          '/icons/science.svg'),
('sub_chinese',  'Chinese',          'chinese',          '/icons/chinese.svg'),
('sub_french',   'Francais',         'francais',         '/icons/french.svg'),
('sub_histgeo',  'Histoire-Geo',     'histoire-geo',     '/icons/histgeo.svg'),
('sub_pe',       'EPS',              'eps',              '/icons/pe.svg'),
('sub_english',  'English',          'english',          '/icons/english.svg'),
('sub_spanish',  'Espagnol',         'espagnol',         '/icons/spanish.svg'),
('sub_malagasy', 'Malagasy',         'malagasy',         '/icons/malagasy.svg');

-- ---------------------------------------------------------
-- CURRICULA (systems_grades + subject)
-- Limited to 2 grade levels per system (start + mid) to keep the
-- seed readable. Extend the same pattern for the other grades.
-- ---------------------------------------------------------
INSERT INTO "public".curricula (id, systems_grades_id, subject_id) VALUES
-- EN - 6th grade
('cur_en6_math',    'sg_en_6th', 'sub_math'),
('cur_en6_science', 'sg_en_6th', 'sub_science'),
('cur_en6_english', 'sg_en_6th', 'sub_english'),
('cur_en6_chinese', 'sg_en_6th', 'sub_chinese'),
-- EN - 9th grade
('cur_en9_math',    'sg_en_9th', 'sub_math'),
('cur_en9_science', 'sg_en_9th', 'sub_science'),
('cur_en9_english', 'sg_en_9th', 'sub_english'),
('cur_en9_chinese', 'sg_en_9th', 'sub_chinese'),
('cur_en9_pe',      'sg_en_9th', 'sub_pe'),

-- FR - 6eme
('cur_fr6_math',    'sg_fr_6e', 'sub_math'),
('cur_fr6_french',  'sg_fr_6e', 'sub_french'),
('cur_fr6_science', 'sg_fr_6e', 'sub_science'),
('cur_fr6_histgeo', 'sg_fr_6e', 'sub_histgeo'),
('cur_fr6_spanish', 'sg_fr_6e', 'sub_spanish'),
('cur_fr6_chinese', 'sg_fr_6e', 'sub_chinese'),
-- FR - 3eme
('cur_fr3_math',    'sg_fr_3e', 'sub_math'),
('cur_fr3_french',  'sg_fr_3e', 'sub_french'),
('cur_fr3_science', 'sg_fr_3e', 'sub_science'),
('cur_fr3_histgeo', 'sg_fr_3e', 'sub_histgeo'),
('cur_fr3_spanish', 'sg_fr_3e', 'sub_spanish'),
('cur_fr3_chinese', 'sg_fr_3e', 'sub_chinese'),
('cur_fr3_pe',      'sg_fr_3e', 'sub_pe'),

-- MG - 6eme
('cur_mg6_math',    'sg_mg_6e', 'sub_math'),
('cur_mg6_french',  'sg_mg_6e', 'sub_french'),
('cur_mg6_science', 'sg_mg_6e', 'sub_science'),
('cur_mg6_histgeo', 'sg_mg_6e', 'sub_histgeo'),
('cur_mg6_malagasy','sg_mg_6e', 'sub_malagasy'),
('cur_mg6_chinese', 'sg_mg_6e', 'sub_chinese'),
-- MG - 3eme
('cur_mg3_math',    'sg_mg_3e', 'sub_math'),
('cur_mg3_french',  'sg_mg_3e', 'sub_french'),
('cur_mg3_science', 'sg_mg_3e', 'sub_science'),
('cur_mg3_histgeo', 'sg_mg_3e', 'sub_histgeo'),
('cur_mg3_malagasy','sg_mg_3e', 'sub_malagasy'),
('cur_mg3_chinese', 'sg_mg_3e', 'sub_chinese'),
('cur_mg3_pe',      'sg_mg_3e', 'sub_pe');

-- ---------------------------------------------------------
-- CHAPTERS
-- Some chapters are reused across systems/grades/subjects on purpose,
-- to demonstrate the many-to-many via curriculum_chapters.
-- ---------------------------------------------------------
INSERT INTO "public".chapters (id, title, description) VALUES
-- Math chapters (shared across EN/FR/MG at "beginner" level)
('ch_fractions',    'Fractions',              'Introduction aux fractions: numerateur, denominateur, simplification.'),
('ch_algebra_basic','Basic Algebra',          'Equations simples et manipulation d''inconnues.'),
('ch_geometry',     'Geometrie de base',      'Figures planes, perimetre et aire.'),
-- Science chapters
('ch_photosynth',   'Photosynthese',          'Comment les plantes produisent leur energie.'),
('ch_atoms',        'Atomes et molecules',    'Structure de la matiere.'),
-- Chinese chapters (shared across the 3 systems)
('ch_cn_numbers',   'Chinese Numbers 1-100',  'Apprendre a compter et lire les nombres en chinois.'),
('ch_cn_greetings', 'Chinese Greetings',      'Salutations et expressions de base en chinois.'),
-- Language-specific chapters
('ch_french_gram',  'Grammaire francaise',    'Conjugaison et accords de base.'),
('ch_spanish_intro','Introduccion al espanol','Vocabulaire et phrases de base en espagnol.'),
('ch_malagasy_intro','Fampidirana ny teny Malagasy','Voambolana sy fehezanteny fototra.'),
('ch_english_gram', 'English Grammar Basics', 'Tenses and sentence structure.'),
-- History-Geo
('ch_histgeo_intro','Introduction a la geographie', 'Reperes geographiques de base.');

-- ---------------------------------------------------------
-- CURRICULUM_CHAPTERS (many-to-many: a chapter can appear in
-- several curricula, across different systems/grades/subjects)
-- ---------------------------------------------------------
INSERT INTO "public".curriculum_chapters (id, curriculum_id, chapter_id) VALUES
-- "Fractions" reused across EN-6th, FR-6eme and MG-6eme Math
('cc_001', 'cur_en6_math', 'ch_fractions'),
('cc_002', 'cur_fr6_math', 'ch_fractions'),
('cc_003', 'cur_mg6_math', 'ch_fractions'),

-- "Basic Algebra" reused at the "mid" grade level across all 3 systems
